{
  "http.max_content_codings": 10,
  "http.content_coding_overflow": "error",
  "http.ignored_content_codings": [],
  "cookie.prefixes": [
    {
      "prefix": "__Secure-",
      "case_sensitive": false,
      "reject_nameless": true,
      "attributes": [
        "secure"
      ]
    },
    {
      "prefix": "__Host-",
      "case_sensitive": false,
      "reject_nameless": true,
      "attributes": [
        "secure",
        "host-only",
        "root-path"
      ]
    },
    {
      "prefix": "__Http-",
      "case_sensitive": false,
      "reject_nameless": true,
      "attributes": [
        "secure",
        "http-only"
      ]
    },
    {
      "prefix": "__Host-Http-",
      "case_sensitive": false,
      "reject_nameless": true,
      "attributes": [
        "secure",
        "http-only",
        "host-only",
        "root-path"
      ]
    }
  ],
  "h3.grease_setting_placement": "last",
  "http.instance_scope": "request",
  "http.cache_scope": "browser-context",
  "http.cache_validators": [
    "if-none-match",
    "if-modified-since"
  ],
  "cache.duplicate_freshness_policy": "first",
  "cache.invalid_freshness_policy": "ignore",
  "cache.freshness_quoted_values": false,
  "cache.delta_seconds_limit": 4294967295,
  "cache.generated_header_order": [
    "if-none-match",
    "if-modified-since",
    "range",
    "if-range",
    "priority"
  ],
  "dns.https_query_recursion_desired": true,
  "dns.https_query_udp_payload_bytes": 4096,
  "dns.https_query_timeout_ms": 2000
}

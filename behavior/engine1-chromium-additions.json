{
  "http.max_content_codings": 10,
  "http.content_coding_overflow": "error",
  "http.ignored_content_codings": [],
  "cookie.prefixes": [
    {
      "prefix": "__Secure-",
      "case_sensitive": false,
      "reject_nameless": true,
      "attributes": [
        "secure"
      ]
    },
    {
      "prefix": "__Host-",
      "case_sensitive": false,
      "reject_nameless": true,
      "attributes": [
        "secure",
        "host-only",
        "root-path"
      ]
    },
    {
      "prefix": "__Http-",
      "case_sensitive": false,
      "reject_nameless": true,
      "attributes": [
        "secure",
        "http-only"
      ]
    },
    {
      "prefix": "__Host-Http-",
      "case_sensitive": false,
      "reject_nameless": true,
      "attributes": [
        "secure",
        "http-only",
        "host-only",
        "root-path"
      ]
    }
  ],
  "h3.grease_setting_placement": "last"
}
